# et-phone-home environment variables
# Copy this file to .env and fill in the values below.
# Full descriptions: bun run src/cli/index.ts help

# Discord bot token used to authenticate the bot. (secret, required)
ETPH_DISCORD_BOT_TOKEN=

# Discord server (guild) ID the bot operates in. (required)
ETPH_DISCORD_GUILD_ID=

# Discord text channel ID used to notify the human that a question is waiting. (required)
ETPH_DISCORD_TEXT_CHANNEL_ID=

# Discord voice channel ID the bot joins to speak the question and listen for an answer. (required)
ETPH_DISCORD_VOICE_CHANNEL_ID=

# Discord user ID of the human to call. (required)
ETPH_DISCORD_USER_ID=

# ElevenLabs API key. (secret, required)
ETPH_ELEVENLABS_API_KEY=

# ElevenLabs voice ID used to synthesize the question. (required)
ETPH_ELEVENLABS_VOICE_ID=

# ElevenLabs text-to-speech model ID.
# ETPH_ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ElevenLabs speech-to-text model ID.
# ETPH_ELEVENLABS_STT_MODEL=scribe_v1

# Milliseconds to wait for the human to join the voice channel before giving up.
# ETPH_CALL_JOIN_TIMEOUT_MS=120000

# Milliseconds of silence that marks the end of the human speaking.
# ETPH_CALL_SILENCE_MS=1500

# Maximum milliseconds to listen for a response before giving up.
# ETPH_CALL_MAX_LISTEN_MS=60000

# Maximum number of rounds spent confirming the transcribed answer with the human.
# ETPH_CALL_CONFIRM_ROUNDS=3

# Words treated as an affirmative confirmation from the human (comma-separated).
# ETPH_CALL_AFFIRMATIVE_WORDS=yes,yeah,yep,correct,right,ja

# Directory where each captured utterance is saved as a WAV file for debugging. Empty disables saving.
# ETPH_CALL_DEBUG_AUDIO_DIR=

# Communication channel to use for asking the human. Currently only "discord" is supported.
# ETPH_CHANNEL=discord
